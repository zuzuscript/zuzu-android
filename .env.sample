# Local Android build environment.
# Make targets load this file automatically.

ANDROID_SDK_ROOT="$HOME/Android/Sdk"
ANDROID_HOME="$ANDROID_SDK_ROOT"
PATH="$ANDROID_SDK_ROOT/platform-tools:$ANDROID_SDK_ROOT/cmdline-tools/latest/bin:$PATH"

# Uncomment and set this if Gradle needs a specific JDK.
# JAVA_HOME="/path/to/jdk"

# Uncomment and set this if Gradle is installed but not on PATH.
# GRADLE="/path/to/gradle"
